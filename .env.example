# Frontend-safe Supabase values. Never put service_role here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Keep true for a local presentation without accounts. Set false in production.
VITE_DEMO_MODE=true
# Temporary public test mode; disable after verification.
VITE_PUBLIC_TEST_MODE=false
VITE_PUBLIC_TEST_ALLOW_ANY_QUERY=false

# Server-only values. Add these in Vercel Project Settings, not in client code.
SERPAPI_KEY=your-serpapi-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_SCRIPT_TOKEN=replace-with-a-long-random-token
# Optional: comma-separated allowed browser origins for cross-origin API calls.
APP_ORIGIN=https://your-project.vercel.app
REQUEST_TIMEOUT_MS=9000

# Temporary public test mode (server-side gate; never leave enabled for formal use).
PUBLIC_TEST_MODE=false
# true allows arbitrary queries; false uses PUBLIC_TEST_QUERY only.
PUBLIC_TEST_ALLOW_ANY_QUERY=false
PUBLIC_TEST_QUERY=4G 吃到飽
PUBLIC_TEST_COOLDOWN_MS=30000

# Question 7: authenticated Vercel proxy -> protected n8n webhook.
N8N_SEO_WEBHOOK_URL=https://your-tunnel.example/webhook/seo-content-generate
SEO_PROXY_SECRET=replace-with-a-random-32-byte-secret
